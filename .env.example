LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct

# Cartesia: set CARTESIA_VOICE_ID to your cloned voice ID (default: stock Suda).
# Uses your account credits. Keep the API key on the server only.
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=ccc7bb22-dcd0-42e4-822e-0731b950972f

# system prompt และข้อมูลร้านไม่ได้ตั้งที่นี่ — แก้ที่ prompts/chat_system.txt และ shop/

# ความยาวคำตอบสูงสุด (completion tokens) — ถ้าไม่ตั้ง Typhoon จะ default แค่ 512
# ทำให้คำตอบยาวๆ ถูกตัด; 16384 คือค่าสูงสุดที่ Typhoon ยอมรับ (ผู้ให้บริการอื่นปรับตามได้)
LLM_MAX_TOKENS=16384
# LLM_TEMPERATURE=0.7

# จำเป็นบน Vercel เท่านั้น (ให้บอทจำบทสนทนาข้าม instance) — ได้จาก Vercel KV
# ถ้าไม่ตั้ง แอปจะเก็บประวัติในหน่วยความจำ process (พอสำหรับรันในเครื่อง)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ตั้งเมื่อมี frontend อยู่คนละโดเมนกับ backend (คั่นหลายอันด้วย ,)
# ALLOWED_ORIGINS=

# --- อ่าน/เข้าใจรูปภาพ ---
# typhoon-ocr (ถอดข้อความจากรูป/PDF สแกน) ใช้ LLM_API_KEY เดิม ไม่ต้องตั้งอะไรเพิ่ม
# ถ้าอยากให้ AI "เข้าใจภาพ" ด้วย (บรรยายรูปถ่าย/กราฟ/ไดอะแกรม) ต่อโมเดล vision แยก
# ขอ key ฟรีที่ https://aistudio.google.com (ไม่ต้องผูกบัตร) — ไม่ตั้ง = อ่านได้แค่ข้อความในรูป
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_API_KEY=
# VISION_MODEL=gemini-flash-latest
# VISION_FALLBACK_MODEL=gemini-flash-lite-latest   # ใช้อัตโนมัติเมื่อโมเดลหลักตอบ 429/503

# --- RAG: ค้นข้อมูลร้านจาก shop/ ---
# embedding ใช้ Gemini key เดียวกับ VISION_* อัตโนมัติ ไม่ต้องตั้งเพิ่ม (ตั้ง EMBED_* เมื่ออยากใช้ผู้ให้บริการอื่น)
# ไม่มีทั้งคู่ = ค้นแบบ lexical (TF-IDF) อย่างเดียว · แก้ข้อมูลใน shop/ แล้วต้องรัน `python -m rag.build_index`
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIMENSIONS=768
# RAG_TOP_K=4

# --- Guardrails (ค่าเริ่มต้นใช้ได้เลย ไม่ต้องตั้ง) ---
# GUARD_MAX_INPUT_CHARS=1000
# GUARD_RATE_LIMIT_PER_MINUTE=15
# GUARD_JUDGE_ENABLED=true          # ใช้ LLM ตรวจเจตนาข้อความขาเข้า (ใช้โควตา Typhoon +1 ครั้ง/ข้อความ)
# GUARD_JUDGE_FAIL_CLOSED=false     # true = ตัวตรวจล่มแล้วปฏิเสธทุกข้อความ

# --- ค้นเว็บอัตโนมัติ (ปิดเป็นค่าเริ่มต้น: บอทร้านต้องตอบจากข้อมูลร้านเท่านั้น) ---
# ถ้าจะเปิด ต้องตั้งทั้งสองค่า — ขอ key ฟรีที่ https://tavily.com
# WEB_SEARCH_ENABLED=true
# SEARCH_API_KEY=tvly-xxxxxxxxxxxxxxxx
